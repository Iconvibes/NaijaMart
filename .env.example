# NaijaMart Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB connection string (leave empty to use in-memory store)
MONGO_URI=

# JWT secret for authentication tokens
# IMPORTANT: Use a strong, unique secret in production
JWT_SECRET=naijamart-dev-secret

# Server port
PORT=5000

# WhatsApp Business API (for vendor order notifications)
# Get these from developers.facebook.com after setting up WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
