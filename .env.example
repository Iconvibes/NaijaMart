# NaijaMart Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB connection string (leave empty to use in-memory store)
# NOTE: The server reads MONGODB_URI (not MONGO_URI)
MONGODB_URI=

# JWT secret for authentication tokens
# CRITICAL: The app REFUSES to start if this is missing or still the default.
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed origins for CORS + WebSocket connections
# In production, set this to your domain(s)
# Example: CORS_ORIGINS=https://naijamart.com,https://www.naijamart.com
CORS_ORIGINS=

# Server port
PORT=5000

# WhatsApp Business API (for vendor order notifications)
# Get these from developers.facebook.com after setting up WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Resend (for email notifications)
# Get from resend.com
RESEND_API_KEY=
EMAIL_FROM=NaijaMart <noreply@naijamart.com>

# OpenAI (for AI product generation)
# Get from platform.openai.com
OPENAI_API_KEY=
